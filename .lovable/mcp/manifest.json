    "issuer": "https://mcoqcinahitfgjgmajdf.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "remix-of-remix-of-bolt-to-lovable",
      "version": "0.1.0",
      "title": "Remix of Remix of Bolt to Lovable"
    },
    "tools": [
      {
        "name": "list_payments",
        "title": "List payments",
        "description": "List the connected account's latest agent payment requests and PayPal Sandbox references.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "default": 25,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "status": {
              "type": "string",
              "maxLength": 40
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "payment_history",
        "title": "Payment history",
        "description": "Read a payment's recorded state changes, delivery reviews, and settlement audit trail for the connected account.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "request_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "request_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
